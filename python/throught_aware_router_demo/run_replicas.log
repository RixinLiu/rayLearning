r refType in referencedTypes)\n            {\n                if (refType is XmlSchemaComplexType complexTypeRef)\n                {\n                    targetSchema.Items.Add(complexTypeRef);\n                    AddReferencedTypes(schemaSet, targetSchema, complexTypeRef.Name);\n                }\n            }\n        }\n    }\n\n    private XmlSchemaComplexType FindComplexType(XmlSchemaSet schemaSet, string typeName)\n    {\n        return schemaSet.GlobalTypes.Values.OfType<XmlSchemaComplexType>().FirstOrDefault(x => x.Name == typeName);\n    }\n\n    private IEnumerable<XmlSchemaType> EnumerateDeep(XmlSchemaComplexType complexType)\n    {\n        if (complexType.ContentTypeParticle is XmlSchemaGroupBase groupBase)\n        {\n            foreach (XmlSchemaParticle particle in groupBase.Items)\n            {\n                if (particle is XmlSchemaElement element && element.ElementSchemaType != null)\n                {\n                    yield return element.ElementSchemaType;\n\n                    if (element.ElementSchemaType is XmlSchemaComplexType nestedComplexType)\n                    {\n                        foreach (var innerType in EnumerateDeep(nestedComplexType))\n                        {\n                            yield return innerType;\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n```\nThis version should resolve the compilation error and maintain lower cognitive complexity. Please try running the tests again and let me know if there are any further issues.", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=-1, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=True, max_tokens=256, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=N