 Google Drive using the provided credentials\n        # TODO: Add code to connect to Google Drive\n\n        # Copy the specified files and folders\n        for file_folder in files_folders:\n            # TODO: Add code to copy the file or folder from Google Drive to AWS\n\n        # Update the database with the copy job information\n        update_database("Google Drive", "Complete")\n    except Exception as e:\n        logging.error(f"Failed to copy files from Google Drive: {e}")\n        update_database("Google Drive", "Failed")\n\n# Function to handle the file copy request from the PWA\ndef handle_copy_request(source, credentials, files_folders):\n    if source == "Office 365":\n        # Start a new thread to copy files from Office 365\n        t = threading.Thread(target=copy_files_office365, args=(credentials, files_folders))\n        t.start()\n    elif source == "Google Drive":\n        # Start a new thread to copy files from Google Drive\n        t = threading.Thread(target=copy\n```', params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=-1, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=True, max_tokens=256, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None), prompt_token_ids: [8420, 374, 458, 3110, 315, 1246, 498, 1410, 912, 279, 2647, 4625, 729, 11, 1465, 11589, 11, 323, 5333, 14887, 311, 279, 10856, 3538, 906, 2038, 510, 73594, 12669, 198, 474, 86061, 17, 198, 474, 4510, 347, 8904, 198, 474, 30159, 198, 474, 8392, 198, 1499, 19534, 1159, 28173, 11, 32058, 11, 1681, 271, 676, 284, 28173, 5513, 606, 40725, 2, 41706, 6546, 198, 25263, 68797, 23669, 70228, 38317, 11, 3561, 1131, 20320, 77077, 16466, 508, 20320, 4528, 675, 7287, 16, 17, 13, 16, 17, 82, 60, 508, 20320, 75641, 7287, 20, 13, 20, 82, 60, 220, 21